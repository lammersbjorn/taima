        }
      }
    },
    "A dry-herb vaporiser spares your lungs the smoke. Smoking is the most harmful way to use." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dry-herb vaporiser spares your lungs the smoke. Smoking is the most harmful way to use."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een kruidenverdamper adem je geen rook in. Roken is de schadelijkste manier van gebruiken."
          }
        }
      }
    },
    "A GitHub issue is public and needs a GitHub account; you see it before it's posted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GitHub issue is public and needs a GitHub account; you see it before it's posted."
