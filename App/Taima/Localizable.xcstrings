          }
        }
      }
    },
    "A CSV file is plain text: anyone who gets it can read your collection and sessions. Photos are not included." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CSV file is plain text: anyone who gets it can read your collection and sessions. Photos are not included."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een CSV-bestand is gewone tekst: iedereen die het krijgt, kan je collectie en sessies lezen. Foto’s staan er niet in."
