    },
    "The bag in use sits on your Lock Screen and Dynamic Island, with buttons to log an amount." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bag in use sits on your Lock Screen and Dynamic Island, with buttons to log an amount."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zakje in gebruik staat op je toegangsscherm en in het Dynamic Island, met knoppen om een hoeveelheid te registreren."
          }
        }
      }
    },
    "The bag you're using sits above the tab bar with a quick log button. Settings moved to the gear in Collection, and Search has its own tab." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bag you're using sits above the tab bar with a quick log button. Settings moved to the gear in Collection, and Search has its own tab."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zakje in gebruik staat boven de tabbladbalk met een knop om snel gebruik te registreren. Instellingen staat onder het tandwiel in Collectie en Zoeken heeft een eigen tabblad."
          }
        }
      }
    },
    "The bag-in-use widget comes in a medium size with all quick amounts." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bag-in-use widget comes in a medium size with all quick amounts."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De widget voor je huidige zakje is er nu ook in middelgroot, met alle snelle hoeveelheden."
          }
        }
      }
    },
    "The card leaves out the product code, price and your notes." : {
