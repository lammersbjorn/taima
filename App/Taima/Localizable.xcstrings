    "Every bag, photo, session, note, wishlist item, learned grower and setting is removed from this iPhone. Backups you already exported are not touched." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every bag, photo, session, note, wishlist item, learned grower and setting is removed from this iPhone. Backups you already exported are not touched."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zakjes, foto’s, sessies, notities, items op je probeerlijst, onthouden telers en instellingen worden van deze iPhone verwijderd. Eerder geëxporteerde back-ups blijven bewaard."
          }
        }
      }
    },
    "Every curated lineage now shows where it comes from. Growers and sources update with the strain library." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every curated lineage now shows where it comes from. Growers and sources update with the strain library."
