    "Discreet mode switches to a plain notes icon and keeps strain names and photos off widgets, the Live Activity, notifications and the app switcher. The name under the icon stays Taima." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discreet mode switches to a plain notes icon and keeps strain names and photos off widgets, the Live Activity, notifications and the app switcher. The name under the icon stays Taima."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discrete modus gebruikt een gewoon notitie-icoon en verbergt soortnamen en foto’s in widgets, de liveactiviteit, meldingen en de appkiezer. De naam onder het icoon blijft Taima."
          }
        }
      }
    },
