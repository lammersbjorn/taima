        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Drugs Infolijn is van Trimbos en beantwoordt je vragen anoniem."
          }
        }
      }
    },
    "The Face ID lock now covers everything, Siri needs an unlocked iPhone, and discreet mode keeps names off the Lock Screen, widgets and Spotlight." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Face ID lock now covers everything, Siri needs an unlocked iPhone, and discreet mode keeps names off the Lock Screen, widgets and Spotlight."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Face ID-vergrendeling beschermt nu alles. Siri vereist een ontgrendelde iPhone en discrete modus verbergt namen op het toegangsscherm, in widgets en in Spotlight."
          }
        }
      }
    },
    "The last 3 months" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
