            "state" : "translated",
            "value" : "Ga niet rijden"
          }
        }
      }
    },
    "Don't drive or use machinery after using. THC slows reactions, and Dutch law sets strict limits." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't drive or use machinery after using. THC slows reactions, and Dutch law sets strict limits."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rijd niet en bedien geen machines na gebruik. THC vertraagt je reactievermogen. In Nederland gelden strenge wettelijke limieten."
          }
        }
      }
    },
    "Don't hold it in" : {
