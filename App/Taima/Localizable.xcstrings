        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij elke samengestelde afstamming zie je nu waar die vandaan komt. Telers en bronnen worden bijgewerkt met de soortenbibliotheek."
          }
        }
      }
    },
    "Every game is in a library under the spin. Start one, deal new prompts, pass the turn and keep score." : {
