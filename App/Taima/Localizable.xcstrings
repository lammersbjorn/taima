          }
        }
      }
    },
    "The Drugs Infolijn is run by Trimbos and answers anonymously." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Drugs Infolijn is run by Trimbos and answers anonymously."
          }
