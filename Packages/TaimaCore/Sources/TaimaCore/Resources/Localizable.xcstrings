    "How many hours were you \"stoned\" on a typical day when you had been using cannabis?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many hours were you \"stoned\" on a typical day when you had been using cannabis?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel uur was je meestal stoned op een dag waarop je cannabis gebruikte?"
          }
        }
      }
    },
    "How often do you use cannabis in situations that could be physically hazardous, such as driving, operating machinery, or caring for children?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often do you use cannabis in situations that could be physically hazardous, such as driving, operating machinery, or caring for children?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak gebruik je cannabis in situaties die gevaarlijk kunnen zijn, zoals bij autorijden, machines bedienen of voor kinderen zorgen?"
          }
        }
      }
    },
    "How often do you use cannabis?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often do you use cannabis?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak gebruik je cannabis?"
          }
        }
      }
    },
    "How often during the past 6 months did you fail to do what was normally expected from you because of using cannabis?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often during the past 6 months did you fail to do what was normally expected from you because of using cannabis?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak lukte het je in de afgelopen 6 maanden door cannabisgebruik niet om te doen wat er van je werd verwacht?"
          }
        }
      }
    },
    "How often during the past 6 months did you find that you were not able to stop using cannabis once you had started?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often during the past 6 months did you find that you were not able to stop using cannabis once you had started?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak merkte je in de afgelopen 6 maanden dat je niet kon stoppen met cannabis gebruiken als je eenmaal was begonnen?"
          }
        }
      }
    },
    "How often in the past 6 months have you devoted a great deal of your time to getting, using, or recovering from cannabis?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often in the past 6 months have you devoted a great deal of your time to getting, using, or recovering from cannabis?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak besteedde je in de afgelopen 6 maanden veel tijd aan het verkrijgen of gebruiken van cannabis, of aan het bijkomen ervan?"
          }
        }
      }
    },
    "How often in the past 6 months have you had a problem with your memory or concentration after using cannabis?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often in the past 6 months have you had a problem with your memory or concentration after using cannabis?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak had je in de afgelopen 6 maanden na cannabisgebruik problemen met je geheugen of concentratie?"
          }
        }
      }
